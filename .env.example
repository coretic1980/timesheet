# Neon: kopieer de connection string (pooled) uit het Neon-dashboard
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Eerste beheerder; wordt alleen gebruikt als er nog geen gebruikers zijn
ADMIN_EMAIL=dave@coretic.nl
ADMIN_NAME=Dave van de Ven
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# e-Boekhouden: Beheer > API-tokens > nieuw token, type "e-Boekhouden API" (niet SOAP)
EB_API_TOKEN=
EB_SOURCE=Coretic

PORT=3000
NODE_ENV=development

# Sleutel voor het versleutelen van 2FA-geheimen (lange willekeurige waarde, nooit wijzigen na gebruik)
APP_SECRET=
# Noodknop: 2FA resetten voor dit e-mailadres bij de volgende start (daarna weer verwijderen)
# MFA_RESET_EMAIL=
